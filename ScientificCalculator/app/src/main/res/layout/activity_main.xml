<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Secondary display - shows previous expression -->
    <TextView
        android:id="@+id/tvsec"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/display_bg"
        android:textColor="#9E9E9E"
        android:textSize="20sp"
        android:gravity="end|bottom"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:ellipsize="start"
        app:layout_constraintHeight_percent="0.09"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Main display - shows current input or result -->
    <TextView
        android:id="@+id/tvmain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/display_bg"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="end|bottom"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:ellipsize="start"
        app:layout_constraintHeight_percent="0.18"
        app:layout_constraintTop_toBottomOf="@id/tvsec"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Button grid - 5 columns x 6 rows -->
    <GridLayout
        android:id="@+id/flow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="5"
        android:rowCount="6"
        android:useDefaultMargins="false"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvmain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 0 -->
        <Button
            android:id="@+id/bac"
            android:text="AC"
            style="@style/CalcBtnOrange"
            android:textColor="@color/red"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="0"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bc"
            android:text="C"
            style="@style/CalcBtnOrange"
            android:textColor="@color/red"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="0"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bb1"
            android:text="("
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_row="0"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bb2"
            android:text=")"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_row="0"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bdiv"
            android:text="÷"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="4"
            android:layout_row="0"
            android:layout_margin="3dp"/>

        <!-- Row 1 -->
        <Button
            android:id="@+id/bsin"
            android:text="sin"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="1"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bcos"
            android:text="cos"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="1"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/btan"
            android:text="tan"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_row="1"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/blog"
            android:text="log"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_row="1"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bln"
            android:text="ln"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="4"
            android:layout_row="1"
            android:layout_margin="3dp"/>

        <!-- Row 2 -->
        <Button
            android:id="@+id/bsquare"
            android:text="x²"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="2"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bsqrt"
            android:text="√"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="2"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/binv"
            android:text="1/x"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_row="2"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bfact"
            android:text="x!"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_row="2"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bmul"
            android:text="×"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="4"
            android:layout_row="2"
            android:layout_margin="3dp"/>

        <!-- Row 3 -->
        <Button
            android:id="@+id/b7"
            android:text="7"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="3"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b8"
            android:text="8"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="3"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b9"
            android:text="9"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_row="3"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bmin"
            android:text="-"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_row="3"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bplus"
            android:text="+"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="4"
            android:layout_row="3"
            android:layout_margin="3dp"/>

        <!-- Row 4 -->
        <Button
            android:id="@+id/b4"
            android:text="4"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="4"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b5"
            android:text="5"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="4"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b6"
            android:text="6"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_row="4"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bpi"
            android:text="π"
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_row="4"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bdot"
            android:text="."
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="4"
            android:layout_row="4"
            android:layout_margin="3dp"/>

        <!-- Row 5 -->
        <Button
            android:id="@+id/b1"
            android:text="1"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="5"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b2"
            android:text="2"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="5"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b3"
            android:text="3"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_row="5"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/b0"
            android:text="0"
            style="@style/CalcBtnWhite"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:layout_row="5"
            android:layout_margin="3dp"/>

        <Button
            android:id="@+id/bequal"
            android:text="="
            style="@style/CalcBtnOrange"
            android:singleLine="true"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="4"
            android:layout_row="5"
            android:layout_margin="3dp"/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>